# ---------------------------------------------------------------------------
# NC Homestead Land Finder — environment configuration
# Copy to .env and fill in real values. Nothing in this app is hardcoded;
# every tunable lives here or in backend/app/core/config.py defaults.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
API_V1_PREFIX=/api

# --- Database ---
POSTGRES_USER=homestead
POSTGRES_PASSWORD=homestead
POSTGRES_DB=homestead
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://homestead:homestead@localhost:5432/homestead

# --- Redis / Celery / caching ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# --- Auth ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Maps ---
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# --- Listing providers ---
# Comma-separated list of provider keys to activate, resolved via the
# provider registry in backend/app/providers/registry.py.
# "mock_nc_land" (deterministic fake data) is available for offline dev/tests
# but is not active by default — real listings require a RentCast API key.
ACTIVE_LISTING_PROVIDERS=rentcast
RENTCAST_API_KEY=
# RentCast free tier: 50 requests/month. Responses are cached 25h (so the
# twice-daily scheduler below makes ~1 real call/day, not 2); the monthly
# counter is a hard stop that refuses new calls once the limit is hit,
# regardless of caching. Raise both if you're on a paid RentCast plan.
RENTCAST_CACHE_TTL_SECONDS=90000
RENTCAST_MONTHLY_CALL_LIMIT=50
LISTING_REFRESH_CRON_HOUR_1=6
LISTING_REFRESH_CRON_HOUR_2=18

# --- Government data sources (stubbed until real keys/endpoints wired in) ---
USDA_RURAL_ELIGIBILITY_API_URL=
USDA_SSURGO_API_URL=https://sdmdataaccess.sc.egov.usda.gov
FEMA_NFHL_API_URL=https://hazards.fema.gov/gis/nfhl/rest/services
CENSUS_API_KEY=
NCDOT_API_URL=
# Statewide parcels FeatureServer (NC OneMap Integrated Cadastral Data Exchange).
# Public, free, no API key required — covers all 100 NC counties.
NC_ONEMAP_PARCELS_URL=https://services.nconemap.gov/secure/rest/services/NC1Map_Parcels/FeatureServer/1

# --- Google Sheets sync ---
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON_PATH=

# --- Notifications ---
NOTIFICATIONS_ENABLED=false
SENDGRID_API_KEY=
NOTIFICATION_EMAIL_FROM=alerts@nchomestead.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUSH_NOTIFICATION_PROVIDER=

# --- Default saved search (seed data) ---
DEFAULT_SEARCH_STATE=NC
DEFAULT_SEARCH_MIN_ACRES=10
DEFAULT_SEARCH_MAX_ACRES=20
DEFAULT_SEARCH_MIN_PRICE=80000
DEFAULT_SEARCH_MAX_PRICE=125000
DEFAULT_SEARCH_STRETCH_PRICE=150000
DEFAULT_SEARCH_HIGHWAY_REF=I-85
DEFAULT_SEARCH_HIGHWAY_MAX_MINUTES=10

# --- Frontend (Vite exposes only VITE_ prefixed vars) ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_MAPBOX_ACCESS_TOKEN=
